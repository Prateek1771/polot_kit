# Jev (OpenRouter Decisions API)
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Set to 1 to emulate Jev with the LLM if the alpha Decisions API is unavailable
JEV_FALLBACK=0

# Every non-Jev LLM call (replies, extraction, sim users, failure explanations) via LiteLLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Langfuse (self-hosted on the host at :3000, or Langfuse Cloud). Traces are sent only when keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Optional; resolved from the keys at API startup when empty
LANGFUSE_PROJECT_ID=

# Render free tier: keep services awake (they sleep after 15 min idle). On Render the API pings its own
# RENDER_EXTERNAL_URL/health automatically; list other services to keep awake, e.g. the web URL.
KEEPALIVE_URLS=
# Ping interval in seconds (keep under 900); 0 disables
KEEPALIVE_SECONDS=600

# InsForge (database + auth). URL and admin API key: .insforge/project.json after `npx -y @insforge/cli link`.
# The API key is a full-access admin key: server-only (API/worker), never NEXT_PUBLIC_*.
INSFORGE_URL=
INSFORGE_API_KEY=
# Web app (public, baked into the Next.js build): same URL, and the anon key from `npx -y @insforge/cli secrets get ANON_KEY`
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Signed-in emails allowed into the Test Lab and review queue (comma-separated)
LAB_ADMIN_EMAILS=
# Optional: link real sign-up emails to demo customers, e.g. you@gmail.com=Priya Sharma,friend@x.com=Arjun Mehta
DEMO_CUSTOMER_EMAILS=
