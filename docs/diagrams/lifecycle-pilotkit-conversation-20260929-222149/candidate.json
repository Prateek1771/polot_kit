  "cards": [
    {
      "dot": "cyan",
      "title": "Status is a column",
      "items": [
        "conversation.status is open, judging or judged (schema.sql:19); the simulator adds error (sim.py:38)",
        "Only an open conversation accepts new turns; /chat returns 409 otherwise (main.py:95-96)"
      ]
    },
    {
      "dot": "violet",
      "title": "Memory drives the flows",
      "items": [
        "Identity and claim progress live in conversation.state JSON, updated every turn (bot.py:439-442)",
        "route() keeps these flows sticky until they finish (bot.py:62-85)"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "No policy data before a full-name match (bot.py:174-206)",
        "No claim row without user confirmation and a passing Jev tool gate (bot.py:250-270)"
      ]
    }
