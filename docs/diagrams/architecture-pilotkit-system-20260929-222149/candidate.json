  "cards": [
    {
      "dot": "violet",
      "title": "Jev decides, the LLM talks",
      "items": [
        "One Jev call per turn answers intent, injection, needs-human, PII, confirms (bot.py:161-172)",
        "Jev runs through LiteLLM as a custom provider, so it is traced like the LLM (jev.py:30-68)",
        "A Jev noul tool gate guards the claim insert; plans are picked in code (bot.py:250-270)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Test Lab in the worker",
      "items": [
        "run_suite_job runs 5 simulated chats at once through the same chat_turn() (sim.py:66-81)",
        "Simulated users' Jev next_move and messages also go through LiteLLM (sim.py:17-62)",
        "judge_job grades with a Jev rubric and writes scores (judge.py:18-64)"
      ]
    },
    {
      "dot": "amber",
      "title": "Knowledge, loaded at import",
      "items": [
        "policy.md broker terms + catalog.yaml (40 plans) form the prompt KB (bot.py:21-46)",
        "customers.yaml is upserted into policy at API startup (main.py:25-44)"
      ]
    }
  ]
